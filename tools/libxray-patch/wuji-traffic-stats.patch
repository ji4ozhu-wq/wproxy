diff --git a/traffic_stats.go b/traffic_stats.go
new file mode 100644
index 0000000..9c5ede5
--- /dev/null
+++ b/traffic_stats.go
@@ -0,0 +1,22 @@
+package libXray
+
+import (
+	"encoding/json"
+
+	"github.com/xtls/libxray/xray"
+)
+
+func invokeGetTrafficStats(payload json.RawMessage) string {
+	request, err := decodePayload[GetTrafficStatsRequest](payload)
+	if err != nil {
+		return encodeInvokeResponse(nil, err)
+	}
+	stats, err := xray.GetTrafficStats(request.InboundTag)
+	if err != nil {
+		return encodeInvokeResponse(nil, err)
+	}
+	return encodeInvokeResponse(&GetTrafficStatsResponse{
+		Uplink:   stats.Uplink,
+		Downlink: stats.Downlink,
+	}, nil)
+}
diff --git a/xray/traffic.go b/xray/traffic.go
