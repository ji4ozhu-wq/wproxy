--- /dev/null
+++ b/xray/traffic.go
@@ -0,0 +1,44 @@
+package xray
+
+import (
+	"errors"
+
+	"github.com/xtls/xray-core/features/stats"
+)
+
+// DefaultTrafficInboundTag is the inbound tag the Wuji iOS tunnel always uses
+// for its TUN inbound, see the config generated by XrayConfigBuilder.
+const DefaultTrafficInboundTag = "tun-in"
+
+// TrafficStats is the cumulative byte counter of one managed inbound.
+type TrafficStats struct {
+	Uplink   int64
+	Downlink int64
+}
+
+// GetTrafficStats returns the cumulative uplink/downlink bytes counted by the
+// running Xray instance for the given inbound tag. The counters only exist when
+// the config enables "policy.system.statsInboundUplink/Downlink" for that
+// inbound, which is part of the Wuji tunnel config.
+func GetTrafficStats(inboundTag string) (*TrafficStats, error) {
+	coreServerMu.Lock()
+	defer coreServerMu.Unlock()
+	if coreServer == nil || !coreServer.IsRunning() {
+		return nil, errors.New("xray is not running")
+	}
+	if inboundTag == "" {
+		inboundTag = DefaultTrafficInboundTag
+	}
+	manager, ok := coreServer.GetFeature(stats.ManagerType()).(stats.Manager)
+	if !ok || manager == nil {
+		return nil, errors.New("stats manager is not available")
+	}
+	result := &TrafficStats{}
+	if counter := manager.GetCounter("inbound>>>" + inboundTag + ">>>traffic>>>uplink"); counter != nil {
+		result.Uplink = counter.Value()
+	}
+	if counter := manager.GetCounter("inbound>>>" + inboundTag + ">>>traffic>>>downlink"); counter != nil {
+		result.Downlink = counter.Value()
+	}
+	return result, nil
+}
